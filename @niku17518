"""
TikTok Account Connection Tool
Инструмент для подключения к аккаунту TikTok через OAuth 2.0
"""

import requests
import json
from typing import Optional, Dict, Tuple
from dataclasses import dataclass
from datetime import datetime, timedelta


@dataclass
class TokenData:
    """Класс для хранения данных токена"""
    access_token: str
    refresh_token: str
    expires_at: datetime
    scope: str
    open_id: str


class TikTokAccountConnector:
    """
    Инструмент для подключения и управления аккаунтом TikTok
    
    Поддерживает:
    - OAuth 2.0 аутентификацию
    - Обновление токенов
    - Получение информации о пользователе
    - Управление сессией
    """
    
    # OAuth endpoints
    OAUTH_AUTHORIZE_URL = "https://www.tiktok.com/v1/oauth/authorize"
    OAUTH_TOKEN_URL = "https://open.tiktokapis.com/v1/oauth/token/"
    API_BASE_URL = "https://open.tiktokapis.com/v1"
    
    def __init__(self, client_id: str, client_secret: str, redirect_uri: str):
        """
        Инициализация коннектора
        
        Args:
            client_id: ID приложения от TikTok
            client_secret: Секретный ключ приложения
            redirect_uri: URL для redirect после авторизации
        """
        self.client_id = client_id
        self.client_secret = client_secret
        self.redirect_uri = redirect_uri
        self.token_data: Optional[TokenData] = None
        self.session = requests.Session()
    
    def get_authorization_url(self, scope: str = "user.info.basic") -> str:
        """
        Генерирует URL для авторизации пользователя
        
        Args:
            scope: Запрашиваемые права доступа
            
        Returns:
            URL для редиректа пользователя
        """
        params = {
            "client_key": self.client_id,
            "response_type": "code",
            "scope": scope,
            "redirect_uri": self.redirect_uri,
            "state": self._generate_state()
        }
        
        query_string = "&".join(f"{k}={v}" for k, v in params.items())
        return f"{self.OAUTH_AUTHORIZE_URL}?{query_string}"
    
    def authenticate(self, auth_code: str) -> Tuple[bool, str]:
        """
        Обменивает код авторизации на токен доступа
        
        Args:
            auth_code: Код авторизации от TikTok
            
        Returns:
            Tuple[успех, сообщение/токен]
        """
        payload = {
            "client_id": self.client_id,
            "client_secret": self.client_secret,
            "code": auth_code,
            "grant_type": "authorization_code",
            "redirect_uri": self.redirect_uri
        }
        
        try:
            response = requests.post(self.OAUTH_TOKEN_URL, json=payload)
            response.raise_for_status()
            
            data = response.json()
            
            if data.get("data"):
                token_info = data["data"]
                expires_in = token_info.get("expires_in", 7200)
                
                self.token_data = TokenData(
                    access_token=token_info["access_token"],
                    refresh_token=token_info["refresh_token"],
                    expires_at=datetime.now() + timedelta(seconds=expires_in),
                    scope=token_info.get("scope", ""),
                    open_id=token_info.get("open_id", "")
                )
                
                return True, f"Успешно подключен аккаунт (User ID: {self.token_data.open_id})"
            else:
                return False, f"Ошибка: {data.get('error_description', 'Неизвестная ошибка')}"
                
        except requests.exceptions.RequestException as e:
            return False, f"Ошибка подключения: {str(e)}"
    
    def refresh_access_token(self) -> Tuple[bool, str]:
        """
        Обновляет токен доступа
        
        Returns:
            Tuple[успех, сообщение]
        """
        if not self.token_data or not self.token_data.refresh_token:
            return False, "Нет refresh token"
        
        payload = {
            "client_id": self.client_id,
            "client_secret": self.client_secret,
            "grant_type": "refresh_token",
            "refresh_token": self.token_data.refresh_token
        }
        
        try:
            response = requests.post(self.OAUTH_TOKEN_URL, json=payload)
            response.raise_for_status()
            
            data = response.json()
            
            if data.get("data"):
                token_info = data["data"]
                expires_in = token_info.get("expires_in", 7200)
                
                self.token_data = TokenData(
                    access_token=token_info["access_token"],
                    refresh_token=token_info["refresh_token"],
                    expires_at=datetime.now() + timedelta(seconds=expires_in),
                    scope=self.token_data.scope,
                    open_id=self.token_data.open_id
                )
                
                return True, "Токен успешно обновлен"
            else:
                return False, f"Ошибка: {data.get('error_description')}"
                
        except requests.exceptions.RequestException as e:
            return False, f"Ошибка обновления токена: {str(e)}"
    
    def get_user_info(self) -> Dict:
        """
        Получает информацию о пользователе
        
        Returns:
            Словарь с информацией о пользователе
        """
        if not self.token_data:
            return {"error": "Не авторизован"}
        
        if self._is_token_expired():
            self.refresh_access_token()
        
        headers = {
            "Authorization": f"Bearer {self.token_data.access_token}",
            "Content-Type": "application/json"
        }
        
        url = f"{self.API_BASE_URL}/user/info/"
        params = {"fields": "open_id,union_id,display_name"}
        
        try:
            response = requests.get(url, headers=headers, params=params)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            return {"error": str(e)}
    
    def get_user_videos(self, max_count: int = 10) -> Dict:
        """
        Получает видео пользователя
        
        Args:
            max_count: Максимальное количество видео
            
        Returns:
            Список видео
        """
        if not self.token_data:
            return {"error": "Не авторизован"}
        
        if self._is_token_expired():
            self.refresh_access_token()
        
        headers = {
            "Authorization": f"Bearer {self.token_data.access_token}",
            "Content-Type": "application/json"
        }
        
        url = f"{self.API_BASE_URL}/video/list/"
        params = {
            "fields": "id,create_time,video_description,share_url",
            "max_count": max_count
        }
        
        try:
            response = requests.get(url, headers=headers, params=params)
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            return {"error": str(e)}
    
    def disconnect(self) -> bool:
        """
        Отключает аккаунт
        
        Returns:
            True если успешно
        """
        self.token_data = None
        return True
    
    def is_authenticated(self) -> bool:
        """Проверяет, авторизован ли пользователь"""
        return self.token_data is not None
    
    def is_token_valid(self) -> bool:
        """Проверяет, валиден ли токен"""
        if not self.token_data:
            return False
        return not self._is_token_expired()
    
    def get_token_info(self) -> Optional[Dict]:
        """Возвращает информацию о токене"""
        if not self.token_data:
            return None
        
        return {
            "user_id": self.token_data.open_id,
            "expires_at": self.token_data.expires_at.isoformat(),
            "scope": self.token_data.scope,
            "valid": self.is_token_valid()
        }
    
    # Private методы
    
    def _is_token_expired(self) -> bool:
        """Проверяет, истёк ли токен"""
        if not self.token_data:
            return True
        return datetime.now() >= self.token_data.expires_at
    
    def _generate_state(self) -> str:
        """Генерирует случайную строку состояния"""
        import uuid
        return str(uuid.uuid4())


